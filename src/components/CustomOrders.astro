---
import { siteConfig, waLink } from '../data/site';
import customBox from '../assets/products/producto-07.jpg';

const ctaHref = waLink(`¡Hola ${siteConfig.name}! Quiero armar un pedido personalizado 💕`);
---

<section
  id="pedidos"
  aria-label="Pedidos personalizados"
  class="bg-gradient-to-b from-background via-primary/25 to-background px-4 py-16 sm:px-6 lg:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-hand text-2xl text-accent">armamos tu idea · pedidos personalizados 💕</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        Pedidos personalizados
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-text-muted">
        Cajitas y boxes personalizados armados a tu gusto, para regalar, sorprender o mimarte. Contanos tu idea por WhatsApp.
      </p>
    </div>

    <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <p class="reveal reveal-delay-1 font-display text-2xl font-medium leading-snug tracking-tight text-text sm:text-[1.65rem]">
          «Cajitas personalizadas, armadas a tu gusto para la ocasión que quieras 💕»
        </p>

        <p class="reveal reveal-delay-2 mt-5 text-lg leading-relaxed text-text-muted">
          En {siteConfig.name} armamos cajitas y boxes personalizados: elegís los dulces y los detalles,
          y lo hacemos realidad con todo el amor. Se pide por WhatsApp y llega a la zona de Burzaco, PBA.
        </p>

        <div class="reveal reveal-delay-3 mt-8 flex flex-col items-start gap-4">
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-whatsapp px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-whatsapp/30 transition hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-whatsapp"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.7-.81-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.97-.14.16-.28.18-.53.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.13-.55-1.32-.76-1.81-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z" />
            </svg>
            Armar mi pedido
          </a>
        </div>

        <ul class="reveal reveal-delay-4 mt-8 flex flex-wrap items-center gap-2.5">
          <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5c-1 0-1.95-.16-2.83-.47L4 21l1.47-3.67A8.38 8.38 0 1 1 21 11.5z" />
            </svg>
            Cajitas personalizadas
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
              <path d="M12 3l1.9 5.7L19.6 10.5l-5.7 1.9L12 18l-1.9-5.6L4.4 10.5l5.7-1.8z" />
            </svg>
            Boxes por ocasión
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
              <path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8" />
              <path d="M22 7H2v5h20z" />
              <path d="M12 22V7" />
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" />
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
            </svg>
            Día del amigo
          </li>
        </ul>
      </div>

      <div class="reveal reveal-delay-2 relative mx-auto mt-2 w-full max-w-md lg:mt-0 lg:max-w-none">
        <figure class="overflow-hidden rounded-[1.75rem] shadow-xl shadow-text/15 ring-4 ring-surface">
          <img
            src={customBox.src}
            alt="Box personalizado de Dulce & Punto para el día del amigo"
            width={customBox.width}
            height={customBox.height}
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </figure>

        <div class="absolute -top-5 right-2 lg:-top-7 lg:right-0">
          <div class="animate-float">
            <div class="flex h-24 w-24 -rotate-12 items-center justify-center rounded-full bg-secondary text-center shadow-lg shadow-text/15 ring-2 ring-white lg:h-28 lg:w-28">
              <span class="font-hand text-[1.35rem] leading-tight text-text">a tu<br />gusto</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

