---
import GalleryGrid from './GalleryGrid';
import { galleryImages } from '../data/gallery';
---

<section
  id="galeria"
  aria-label="Galería"
  class="bg-gradient-to-b from-background via-primary/30 to-background px-4 py-16 sm:px-6 lg:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-hand text-2xl text-accent">hecho con amor</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">Galería</h2>
      <p class="mt-3 text-lg leading-relaxed text-text-muted">
        Un poquito de todo lo que hacemos en Burzaco, PBA. Tocá cualquier foto para verla en grande.
      </p>
    </div>

    <div class="mt-10">
      <GalleryGrid client:load images={galleryImages} />
    </div>
  </div>
</section>