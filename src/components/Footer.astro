---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import perfil from '../assets/logo/perfil-1024.jpg';

const year = new Date().getFullYear();
const phoneDisplay = '011 6515-9776';
const phoneTel = 'tel:+5491165159776';

const links = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#productos', label: 'Productos' },
  { href: '#pedidos', label: 'Pedidos' },
  { href: '#galeria', label: 'Galería' },
  { href: '#sobre', label: 'Sobre nosotros' },
  { href: '#contacto', label: 'Contacto' },
];

const socials = [
  { key: 'instagram', href: siteConfig.instagram, label: 'Instagram', handle: '@dulceypunto.love' },
  { key: 'tiktok', href: siteConfig.tiktok, label: 'TikTok', handle: '@DulceyPunto.love ❤️' },
  { key: 'facebook', href: siteConfig.facebook, label: 'Facebook', handle: 'Dulce & Punto' },
];
---

<footer
  aria-label="Pie de página"
  class="border-t border-accent/15 bg-background"
>
  <div class="reveal mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-8">
      <div class="max-w-xs">
        <a href="#inicio" class="group flex min-w-0 items-center gap-3" aria-label="Dulce & Punto — volver al inicio">
          <span class="shrink-0 overflow-hidden rounded-full ring-1 ring-accent/30 ring-offset-2 ring-offset-background transition-transform duration-300 group-hover:scale-105">
            <Image
              src={perfil}
              alt="Logo de Dulce & Punto"
              width={96}
              height={96}
              loading="lazy"
              decoding="async"
              class="h-11 w-11 rounded-full object-cover"
            />
          </span>
          <span class="min-w-0 leading-none">
            <span class="block truncate font-display text-lg font-semibold tracking-tight text-text">Dulce &amp; Punto</span>
            <span class="block truncate font-hand text-base text-accent">hecho con amor</span>
          </span>
        </a>
        <p class="mt-5 text-base leading-relaxed text-text-muted">
          Detalles dulces para regalar, sorprender o mimarte 💕 — Desayunos, meriendas y
          cajitas personalizadas. ¡Hacemos todo con amor!
        </p>
      </div>

      <nav class="lg:pl-10" aria-label="Navegación del pie de página">
        <p class="font-hand text-2xl text-accent">navegación</p>
        <ul class="mt-4 flex flex-col items-start gap-2.5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-1.5 text-[0.95rem] font-medium text-text/80 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:pl-10">
        <p class="font-hand text-2xl text-accent">contacto</p>
        <ul class="mt-4 flex flex-col items-start gap-2.5">
          <li>
            <a
              href={phoneTel}
              class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-text/80 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-accent" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              {phoneDisplay}
            </a>
          </li>
          <li>
            <span class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-text/80">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-accent" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              Burzaco, PBA
            </span>
          </li>
        </ul>

        <ul class="mt-5 flex items-center gap-2.5" aria-label="Redes sociales">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  title={`${social.label} · ${social.handle}`}
                  class="grid h-11 w-11 place-items-center rounded-full bg-primary/60 text-text ring-1 ring-accent/20 transition hover:-translate-y-0.5 hover:bg-secondary/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  {
                    social.key === 'instagram' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                      </svg>
                    )
                  }
                  {
                    social.key === 'tiktok' && (
                      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
                      </svg>
                    )
                  }
                  {
                    social.key === 'facebook' && (
                      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                        <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z" />
                      </svg>
                    )
                  }
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-accent/15 pt-6 sm:flex-row">
      <p class="text-sm font-medium text-text-muted">© {year} {siteConfig.name}</p>
      <p class="font-hand text-xl text-accent">hecho con amor 💕</p>
    </div>
  </div>
</footer>