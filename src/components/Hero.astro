---
import { siteConfig, waLink } from '../data/site';
import matesBox from '../assets/products/producto-12.jpg';
import amigoBox from '../assets/products/producto-04.jpg';
import combo from '../assets/products/producto-13.jpg';

const ctaHref = waLink(`¡Hola ${siteConfig.name}! Quiero hacer una consulta 💕`);
---

<section
  id="inicio"
  aria-label="Inicio"
  class="relative grid min-h-[calc(100svh-4rem)] place-items-center overflow-hidden bg-gradient-to-b from-primary/60 via-background to-background px-4 pb-16 pt-14 sm:px-6 lg:min-h-[calc(100svh-4.5rem)] lg:pb-20 lg:pt-16"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="hero-blob absolute -right-24 -top-24 h-96 w-96 rounded-full bg-secondary/50 blur-3xl"></div>
    <div class="hero-blob absolute -left-28 bottom-0 h-80 w-80 rounded-full bg-primary/80 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
    <div class="text-center lg:text-left">
      <p class="hero-reveal inline-flex items-center gap-2 font-hand text-2xl text-accent sm:text-[1.7rem]">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
          <path d="M12 21s-6.7-4.35-9.33-8.11C.6 9.8 2.1 5.5 5.6 5.5c2 0 3.2 1.2 4.4 2.8 1.2-1.6 2.4-2.8 4.4-2.8 3.5 0 5 4.3 2.93 7.39C18.7 16.65 12 21 12 21z" />
        </svg>
        repostería 100% casera · Burzaco, PBA
      </p>

      <h1 class="hero-reveal hero-delay-1 mt-5 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-text sm:text-5xl lg:text-[3.5rem]">
        Detalles dulces para regalar, sorprender o mimarte <span aria-hidden="true">💕</span>
      </h1>

      <p class="hero-reveal hero-delay-2 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-text-muted lg:mx-0 lg:text-xl">
        Desayunos, meriendas, tartas 100% caseras y cajitas personalizadas. ¡Hacemos todo con amor!
      </p>

      <div class="hero-reveal hero-delay-3 mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-whatsapp px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-whatsapp/30 transition hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-whatsapp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.7-.81-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.97-.14.16-.28.18-.53.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.13-.55-1.32-.76-1.81-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z" />
          </svg>
          Consultar por WhatsApp
        </a>
        <a
          href="#productos"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-accent/40 bg-surface/60 px-7 py-3.5 text-base font-semibold text-text transition hover:border-accent hover:bg-secondary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Ver productos
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M12 5v14M19 12l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <ul class="hero-reveal hero-delay-4 mt-9 flex flex-wrap items-center justify-center gap-2.5 lg:justify-start">
        <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-accent" aria-hidden="true">
            <path d="M12 21s-6.7-4.35-9.33-8.11C.6 9.8 2.1 5.5 5.6 5.5c2 0 3.2 1.2 4.4 2.8 1.2-1.6 2.4-2.8 4.4-2.8 3.5 0 5 4.3 2.93 7.39C18.7 16.65 12 21 12 21z" />
          </svg>
          100% casero
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5c-1 0-1.95-.16-2.83-.47L4 21l1.47-3.67A8.38 8.38 0 1 1 21 11.5z" />
          </svg>
          Pedidos por WhatsApp
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-text/80 backdrop-blur-sm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Burzaco, PBA
        </li>
      </ul>
    </div>

    <div class="relative mx-auto mt-4 w-full max-w-md lg:mt-0 lg:max-w-none">
      <div class="grid aspect-[4/5] grid-cols-12 grid-rows-6 gap-3 sm:gap-4">
        <figure class="hero-reveal hero-delay-3 col-span-5 col-start-1 row-span-3 row-start-1">
          <div class="h-full w-full -rotate-3">
            <img
              src={amigoBox.src}
              alt="Box personalizado de Dulce & Punto"
              width={1160}
              height={2048}
              loading="eager"
              decoding="async"
              class="h-full w-full rounded-[1.75rem] object-cover shadow-lg shadow-text/10 ring-4 ring-surface"
            />
          </div>
        </figure>

        <figure class="hero-reveal hero-delay-1 z-10 col-span-8 col-start-3 row-span-5 row-start-2">
          <div class="h-full w-full rotate-2">
            <img
              src={matesBox.src}
              alt="Box para mates con dulces variados de Dulce & Punto"
              width={1080}
              height={1080}
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="h-full w-full rounded-[2rem] object-cover shadow-xl shadow-text/15 ring-4 ring-surface"
            />
          </div>
        </figure>

        <figure class="hero-reveal hero-delay-2 col-span-5 col-start-9 row-span-4 row-start-4">
          <div class="h-full w-full -rotate-3">
            <img
              src={combo.src}
              alt="Combo de dulces de Dulce & Punto"
              width={1152}
              height={2048}
              loading="eager"
              decoding="async"
              class="h-full w-full rounded-[1.75rem] object-cover shadow-lg shadow-text/10 ring-4 ring-surface"
            />
          </div>
        </figure>
      </div>

      <div class="hero-reveal hero-delay-4 absolute -top-5 right-2 z-20 lg:-top-7 lg:right-0">
        <div class="hero-float">
          <div class="flex h-24 w-24 -rotate-12 items-center justify-center rounded-full bg-secondary text-center shadow-lg shadow-text/15 ring-2 ring-white lg:h-28 lg:w-28">
            <span class="font-hand text-[1.35rem] leading-tight text-text">hecho<br />con amor</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-blob-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(0, 14px) scale(1.06);
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .hero-reveal {
    opacity: 0;
    animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-delay-1 {
    animation-delay: 0.15s;
  }

  .hero-delay-2 {
    animation-delay: 0.3s;
  }

  .hero-delay-3 {
    animation-delay: 0.45s;
  }

  .hero-delay-4 {
    animation-delay: 0.6s;
  }

  .hero-blob {
    animation: hero-blob-drift 14s ease-in-out infinite;
  }

  .hero-float {
    animation: hero-float 6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      animation: none;
    }

    .hero-blob,
    .hero-float {
      animation: none;
    }
  }
</style>