---
import { siteConfig, waLink } from '../data/site';

const phoneDisplay = '011 6515-9776';
const phoneTel = 'tel:+5491165159776';
const waHref = waLink(`¡Hola ${siteConfig.name}! Quiero hacer una consulta 💕`);
---

<section
  id="contacto"
  aria-label="Contacto"
  class="bg-gradient-to-b from-background via-primary/25 to-background px-4 py-16 sm:px-6 lg:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="font-hand text-2xl text-accent">escribinos · te respondemos 💕</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">Contacto</h2>
      <p class="mt-3 text-lg leading-relaxed text-text-muted">
        Hacé tu consulta o pedido por WhatsApp, o seguinos en las redes. Estamos en Burzaco, PBA.
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-10 grid items-center gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <div class="rounded-[1.5rem] bg-surface p-7 shadow-md shadow-text/10 ring-1 ring-accent/15 sm:p-8">
        <h3 class="font-display text-2xl font-semibold tracking-tight text-text">¿Consultas o pedidos?</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          Escribinos por WhatsApp y armamos tu pedido con todo el amor. También podés copiar el teléfono o encontrarnos en las redes.
        </p>

        <div class="mt-6 flex flex-col items-start gap-4">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-whatsapp px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-whatsapp/30 transition hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-whatsapp"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.7-.81-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.97-.14.16-.28.18-.53.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.13-.55-1.32-.76-1.81-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z" />
            </svg>
            Consultar por WhatsApp
          </a>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href={phoneTel}
              class="inline-flex items-center gap-2 rounded-full border border-accent/30 px-4 py-2 text-sm font-semibold text-text transition hover:border-accent hover:bg-secondary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              {phoneDisplay}
            </a>
            <button
              id="copy-phone"
              type="button"
              data-phone={phoneDisplay}
              class="inline-flex items-center gap-2 rounded-full border border-accent/30 px-4 py-2 text-sm font-semibold text-text transition hover:border-accent hover:bg-secondary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span id="copy-label">Copiar</span>
            </button>
          </div>
        </div>

        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-background px-3.5 py-1.5 text-sm font-medium text-text/80">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-4 w-4 text-accent" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Burzaco, PBA
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <a
          href={siteConfig.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-[1.5rem] bg-surface p-5 shadow-md shadow-text/10 ring-1 ring-accent/15 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-text/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-primary/60 text-text ring-1 ring-accent/20 transition group-hover:bg-secondary/60">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-5 w-5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-lg font-semibold leading-tight text-text">Instagram</span>
            <span class="block truncate font-hand text-lg leading-tight text-accent">@dulceypunto.love</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-5 w-5 shrink-0 text-accent transition group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>

        <a
          href={siteConfig.tiktok}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-[1.5rem] bg-surface p-5 shadow-md shadow-text/10 ring-1 ring-accent/15 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-text/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-primary/60 text-text ring-1 ring-accent/20 transition group-hover:bg-secondary/60">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-lg font-semibold leading-tight text-text">TikTok</span>
            <span class="block truncate font-hand text-lg leading-tight text-accent">@DulceyPunto.love ❤️</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-5 w-5 shrink-0 text-accent transition group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>

        <a
          href={siteConfig.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-[1.5rem] bg-surface p-5 shadow-md shadow-text/10 ring-1 ring-accent/15 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-text/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-primary/60 text-text ring-1 ring-accent/20 transition group-hover:bg-secondary/60">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z" />
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-lg font-semibold leading-tight text-text">Facebook</span>
            <span class="block truncate font-hand text-lg leading-tight text-accent">Dulce &amp; Punto</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="h-5 w-5 shrink-0 text-accent transition group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-phone');
  const copyLabel = document.getElementById('copy-label');
  copyBtn?.addEventListener('click', async () => {
    const phone = copyBtn.dataset.phone ?? '';
    try {
      await navigator.clipboard.writeText(phone);
      if (copyLabel) {
        copyLabel.textContent = '¡Copiado!';
        setTimeout(() => {
          copyLabel.textContent = 'Copiar';
        }, 2000);
      }
    } catch {
      // Clipboard no disponible: se ignora silenciosamente.
    }
  });
</script>