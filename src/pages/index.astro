---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
---

<Layout
  title="Dulce & Punto — Detalles dulces para regalar, sorprender o mimarte 💕"
  description="Desayunos, meriendas, tartas 100% caseras y cajitas personalizadas. Dulce & Punto — Burzaco, PBA. Pedidos por WhatsApp."
>
  <Navbar />
  <main>
    <Hero />

    <section id="productos" aria-label="Productos" class="grid min-h-[70vh] place-items-center bg-surface px-4">
      <div class="text-center">
        <h2 class="font-display text-3xl text-text">Productos</h2>
        <p class="mt-2 font-hand text-2xl text-accent">Sección en construcción (Fase 3 del roadmap)</p>
      </div>
    </section>

    <section id="galeria" aria-label="Galería" class="grid min-h-[70vh] place-items-center px-4">
      <div class="text-center">
        <h2 class="font-display text-3xl text-text">Galería</h2>
        <p class="mt-2 font-hand text-2xl text-accent">Sección en construcción (Fase 3 del roadmap)</p>
      </div>
    </section>

    <section id="sobre" aria-label="Sobre nosotros" class="grid min-h-[70vh] place-items-center bg-surface px-4">
      <div class="text-center">
        <h2 class="font-display text-3xl text-text">Sobre nosotros</h2>
        <p class="mt-2 font-hand text-2xl text-accent">Sección en construcción (Fase 3 del roadmap)</p>
      </div>
    </section>

    <section id="contacto" aria-label="Contacto" class="grid min-h-[70vh] place-items-center px-4">
      <div class="text-center">
        <h2 class="font-display text-3xl text-text">Contacto</h2>
        <p class="mt-2 font-hand text-2xl text-accent">Sección en construcción (Fase 3 del roadmap)</p>
      </div>
    </section>
  </main>
</Layout>